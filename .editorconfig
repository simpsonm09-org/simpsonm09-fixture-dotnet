root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[*.ps1]
indent_size = 4

[justfile]
indent_size = 4

[Makefile]
indent_style = tab

# Code-metrics analyzers are off by default; the complexity gate runs them.
[*.cs]
dotnet_diagnostic.CA1502.severity = error
dotnet_diagnostic.CA1505.severity = error
dotnet_diagnostic.CA1506.severity = error
